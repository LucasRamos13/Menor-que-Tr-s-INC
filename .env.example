# ==============================================================================
# Menor que Três — variáveis de ambiente
#
# Copie este arquivo para ".env.local" (desenvolvimento) e preencha com os
# valores reais. NUNCA commite ".env.local" nem qualquer arquivo com
# credenciais reais — o .gitignore já bloqueia isso por padrão.
#
# Em produção (Cloudflare Pages), configure as mesmas variáveis no painel:
# Workers & Pages > seu projeto > Settings > Environment variables.
# ==============================================================================

# --- Supabase --------------------------------------------------------------
# Painel do projeto Supabase > Project Settings > API.
# NEXT_PUBLIC_* ficam expostas ao navegador — são seguras porque o acesso real
# aos dados é controlado pelas políticas de Row Level Security no banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-public-key

# --- Google OAuth (login E integração com o Google Calendar) ---------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID.
# O MESMO client ID/secret é usado tanto pelo login (configurado dentro do
# Supabase Auth) quanto pela conexão de Calendar (usada diretamente pelo
# servidor Next.js em src/lib/google/oauth.ts). Nunca exponha o client secret
# ao navegador — por isso ele não tem o prefixo NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Observação: o redirect_uri do fluxo de Google Calendar é montado
# automaticamente a partir da URL da própria requisição (origin), então não
# há uma variável separada de "site URL" para manter — apenas garanta que
# cada origin usado (localhost, preview, produção) esteja cadastrado como
# "Authorized redirect URI" no Google Cloud Console (ver README).
